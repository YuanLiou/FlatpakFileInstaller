[Desktop Entry]
Type=Application
Name=Flatpak File Installer
GenericName=App Installer
Comment=Install apps you downloaded from the internet
Keywords=flatpak;flathub;install;app;software;
Exec=flatpak-file-installer %f
Icon=io.github.yuanliou.FlatpakFileInstaller
Terminal=false
StartupNotify=true
Categories=System;PackageManager;
MimeType=application/vnd.flatpak;application/vnd.flatpak.ref;
