<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<component type="desktop-application">
  <id>io.github.yuanliou.FlatpakFileInstaller</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>Flatpak File Installer</name>
  <summary>Install downloaded apps by dragging them</summary>
  <description>
    <p>Downloaded an app that ends in “.flatpak” or “.flatpakref”? Double-click it and drag the app to where you want to install it, just like on a Mac.</p>
    <p>Choose “Just for me” to install it only for yourself, or “Everyone on this computer” so that everybody who uses the computer can open it.</p>
  </description>

  <developer id="io.github.yuanliou">
    <name translate="no">YuanLiou</name>
  </developer>

  <launchable type="desktop-id">io.github.yuanliou.FlatpakFileInstaller.desktop</launchable>
  <url type="homepage">https://github.com/YuanLiou/FlatpakFileInstaller</url>
  <url type="bugtracker">https://github.com/YuanLiou/FlatpakFileInstaller/issues</url>
  <url type="vcs-browser">https://github.com/YuanLiou/FlatpakFileInstaller</url>

  <provides>
    <binary>flatpak-file-installer</binary>
    <mediatype>application/vnd.flatpak</mediatype>
    <mediatype>application/vnd.flatpak.ref</mediatype>
  </provides>

  <categories>
    <category>System</category>
    <category>PackageManager</category>
  </categories>

  <supports>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#a6cbf5</color>
    <color type="primary" scheme_preference="dark">#1b4b8a</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Drag the app to where you want to install it</caption>
      <image>https://raw.githubusercontent.com/YuanLiou/FlatpakFileInstaller/v1.0.1/docs/screenshots/en/ready.png</image>
    </screenshot>
    <screenshot>
      <caption>Choose what to do when the app is already installed</caption>
      <image>https://raw.githubusercontent.com/YuanLiou/FlatpakFileInstaller/v1.0.1/docs/screenshots/en/already-installed.png</image>
    </screenshot>
    <screenshot>
      <caption>Open the app right after installing it</caption>
      <image>https://raw.githubusercontent.com/YuanLiou/FlatpakFileInstaller/v1.0.1/docs/screenshots/en/installed.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0.1" date="2026-10-26">
      <description>
        <p>Adds screenshots and colors for app stores. The app itself hasn't changed.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-10-26">
      <description>
        <p>The first release.</p>
        <ul>
          <li>Install “.flatpak” and “.flatpakref” files by dragging the app to “Just for me” or “Everyone on this computer”.</li>
          <li>See where an app comes from and what it can do before you install it.</li>
          <li>If the app is already installed, choose whether to open it, update it or install it again.</li>
          <li>Anything else an app needs is downloaded from Flathub automatically.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
