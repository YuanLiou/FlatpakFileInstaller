<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<component type="desktop-application">
  <id>io.github.yuanliou.FlatpakAppInstaller</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>Flatpak App Installer</name>
  <summary>Install downloaded apps by dragging them</summary>
  <description>
    <p>Downloaded an app that ends in “.flatpak” or “.flatpakref”? Double-click it and drag the app to where you want to install it, just like on a Mac.</p>
    <p>Choose “Just for me” to install it only for yourself, or “Everyone on this computer” so that everybody who uses the computer can open it.</p>
  </description>

  <developer id="io.github.yuanliou">
    <name translate="no">YuanLiou</name>
  </developer>

  <launchable type="desktop-id">io.github.yuanliou.FlatpakAppInstaller.desktop</launchable>
  <url type="homepage">https://github.com/YuanLiou/FlatpakAppInstaller</url>
  <url type="bugtracker">https://github.com/YuanLiou/FlatpakAppInstaller/issues</url>
  <url type="vcs-browser">https://github.com/YuanLiou/FlatpakAppInstaller</url>

  <provides>
    <binary>flatpak-app-installer</binary>
    <mediatype>application/vnd.flatpak</mediatype>
    <mediatype>application/vnd.flatpak.ref</mediatype>
  </provides>

  <categories>
    <category>System</category>
    <category>PackageManager</category>
  </categories>

  <supports>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-10-26">
      <description>
        <p>First development version.</p>
      </description>
    </release>
  </releases>
</component>
